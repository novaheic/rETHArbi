# Ethereum JSON-RPC (required for live mode)
ETH_RPC_HTTP=https://ethereum.publicnode.com
ETH_RPC_WS=

# Database — SQLite by default; PostgreSQL preferred for long runs
# DATABASE_URL=postgresql+asyncpg://reth:reth@localhost:5432/reth_basis
DATABASE_URL=sqlite+aiosqlite:///./data/reth_basis.db

# Sampling
POLL_INTERVAL_SECONDS=15
PROTOCOL_POLL_EVERY_BLOCK=true

# Capital simulations (EUR)
CAPITAL_EUR_1=500
CAPITAL_EUR_2=1000
TRADE_SIZES_EUR=250,500,1000,2500,5000,10000

# Cost assumptions
MAX_GAS_EUR=5
MEV_COST_BPS=2
ETH_EUR_FALLBACK=3000

# Strategy thresholds (bp)
ENTRY_THRESHOLDS_BPS=-10,-15,-20,-25,-30,-40,-50,-75,-100
EXIT_THRESHOLDS_BPS=0,-5,-10
MAX_HOLDING_SECONDS=3600,21600,43200,86400,259200,604800,2592000
MIN_ENTRY_BASIS_BPS=20

# Runtime
DEMO_MODE=false
LOG_LEVEL=INFO
REPORTS_DIR=./reports
